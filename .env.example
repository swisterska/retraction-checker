# Copy these entries into .env and fill in SMTP_HOST, account details, and sender.
# Match APP_PUBLIC_URL to the address where the browser opens the frontend.
PORT=5003
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=false
MAIL_FROM=retraction-checker@localhost

# Optional GROBID request safety limit, in seconds (default: 300).
GROBID_TIMEOUT=300
